# Node.js dependencies and package-manager state
**/node_modules/
**/.pnp/
**/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment configuration (keep shareable templates)
**/.env
**/.env.*
**/*.env
!**/.env.example
!**/.env.sample
!**/.env.template

# Local runtime output
**/uploads/
**/upload/
**/logs/
**/coverage/
**/.cache/
**/.eslintcache
**/.nyc_output/
**/build/
**/dist/

# Application secrets
**/secrets/
**/secret/
**/*.secret
**/*.secrets
**/credentials.json
**/service-account*.json

# Certificates and private keys
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.pfx
**/*.p12
**/*.jks
**/*.keystore
**/priv_sk

# Hyperledger Fabric wallets, identities, and generated crypto material
**/wallet/
**/wallets/
**/identity/
**/identities/
**/crypto-config/
**/keystore/
**/signcerts/
**/msp/
**/fabric-ca-client/
**/hfc-key-store/
**/organizations/

# Local editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
